# === JWT-ключи (RSA) — пути к файлам ===
# Для prod: Render Secret Files монтируются в /etc/secrets/
RSA_PRIVATE_KEY_PATH=file:/etc/secrets/private.pem
RSA_PUBLIC_KEY_PATH=file:/etc/secrets/public.pem

# === База данных (prod) ===
JDBC_DATABASE_URL=jdbc:postgresql://localhost:5432/hexlet_cv
DB_USERNAME=hexlet
DB_PASSWORD=

# === Интеграции (задел на будущее, в коде пока нет) ===
HH_API_TOKEN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Локальный запуск: сгенерируй свои dev-ключи
# openssl genrsa -out src/main/resources/certs/private.pem 2048
# openssl rsa -in src/main/resources/certs/private.pem -pubout -out src/main/resources/certs/public.pem